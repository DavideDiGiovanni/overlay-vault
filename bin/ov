#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

source "${PROJECT_ROOT}/lib/output.sh"
source "${PROJECT_ROOT}/lib/discovery.sh"
source "${PROJECT_ROOT}/lib/config.sh"
source "${PROJECT_ROOT}/lib/commands/init.sh"
source "${PROJECT_ROOT}/lib/commands/config.sh"

usage() {
    cat <<'EOF'
Usage:
  ov init [absolute-repo-path]
  ov config list
  ov config get <key>
  ov config set <key=value>
  ov status
  ov mount
  ov umount
  ov del <file>
  ov restore <file>
  ov push
  ov reset
EOF
}

require_repo() {
    if ! ov_find_repo_root >/dev/null 2>&1; then
        ov_fatal_not_repo
    fi
}

main() {
    local cmd="${1:-}"

    case "${cmd}" in
        init)
            shift
            ov_cmd_init "$@"
            ;;
        config)
            shift
            require_repo
            ov_cmd_config "$@"
            ;;
        ""|-h|--help|help)
            usage
            ;;
        status|mount|umount|del|restore|push|reset)
            require_repo
            ov_error "command '${cmd}' not implemented yet"
            exit 1
            ;;
        *)
            ov_error "unknown command: ${cmd}"
            echo
            usage
            exit 1
            ;;
    esac
}

main "$@"